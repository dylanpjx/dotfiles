picom -b &
/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 2> /dev/null &
xrandr --output HDMI-A-0 --mode 1920x1080 --rate 144.00 --rotate left --left-of DisplayPort-2
xrandr --output DisplayPort-2 --mode 3840x2160 --rate 143.99

xset s off
xset -dpms
xset s noblank
xset +fp /home/dylan/.local/share/fonts
xset fp rehash

sleep 5
xset r rate 250 30
